# Copy to .env and fill in ONE key. The client speaks the OpenAI Chat Completions
# tool-calling protocol, so any compatible gateway works.

# Preferred: explicit override (wins over the provider-specific variables below).
AUDIT_LLM_API_KEY=
AUDIT_LLM_BASE_URL=https://api.deepseek.com
AUDIT_LLM_MODEL=deepseek-v4-pro
# DeepSeek thinking depth: low / high / max. Empty disables the parameter for gateways that reject it.
AUDIT_LLM_REASONING_EFFORT=max

# Optional fallbacks. If AUDIT_LLM_* is empty, the loader checks these in order:
# DEEPSEEK_*, OPENAI_*, MOONSHOT_*, DASHSCOPE_*.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Moonshot / Kimi (OpenAI-compatible).
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k3

# Alibaba DashScope compatible mode (Qwen).
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# Optional separate critic model. Empty AUDIT_CRITIC_MODEL = the critic reuses the auditor's model.
# Empty AUDIT_CRITIC_API_KEY = reuse the auditor's key and base URL.
AUDIT_CRITIC_MODEL=
AUDIT_CRITIC_API_KEY=
AUDIT_CRITIC_BASE_URL=
AUDIT_CRITIC_REASONING_EFFORT=
# Example, Kimi as critic: AUDIT_CRITIC_MODEL=kimi-k3  AUDIT_CRITIC_BASE_URL=https://api.moonshot.cn/v1

# Audit target and loop budget.
AUDIT_TARGET_URL=https://github.com/gwind/ylinux_old
AUDIT_TARGET_COMMIT=8a7316deec88287d020eca21c38dad921b623ffc
# Extra directories to skip by default (comma-separated). static/media/vendor-style names are always skipped.
AUDIT_VENDOR_DIRS=lib/markdown
AUDIT_MAX_STEPS=80
AUDIT_CRITIC_STEPS=40
AUDIT_RESUME_STEPS=40
AUDIT_MAX_ROUNDS=3
